<launch>
    <node name="audio_router" pkg="multiaudio_transmit" type="audio_router_node.py" output="screen" />

    <node name="operator_audio_capture" pkg="audio_capture" type="audio_capture" output="screen">
        <param name="bitrate" value="128"/>
        <param name="device" value="plughw:4,0"/> 
        <param name="channels" value="1"/>
        <param name="sample_rate" value="44100"/>
        <param name="format" value="mp3"/>
        <remap from="audio" to="operator/audio_out_raw" />
    </node>

    <node name="operator_audio_play" pkg="audio_play" type="audio_play" output="screen">
        <param name="device" value=""/> 
        <param name="format" value="mp3"/>
        <remap from="audio" to="operator/audio_in" />
    </node>
</launch>